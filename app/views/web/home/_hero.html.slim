- start_course = catalog.start_course

section.hb-hero aria-labelledby="hero-title"
  .hb-wrap.hb-hero__grid
    div
      p.hb-eyebrow = t('.eyebrow')
      h1#hero-title = t('.h1_html')
      p.hb-lead = t('.lead')
      .hb-cta
        - if start_course&.first_lesson_slug
          = link_to t('.start', course: start_course.name), language_lesson_path(start_course.slug, start_course.first_lesson_slug), class: 'hb-btn hb-btn--primary'
        = link_to t('.all_courses'), '#cursos', class: 'hb-btn hb-btn--ghost'
      - if current_user.guest?
        p.hb-note = t('.note')

    / NOTE: статический пример, не настоящий редактор; подсветка — только CSS-классами
    figure.hb-lesson aria-label=t('.example.label')
      .hb-lesson__bar
        span.hb-lesson__dots aria-hidden="true"
          span
          span
          span
        strong = t('.example.title')
      .hb-lesson__text
        p.hb-lesson__question = t('.example.question')
        p = t('.example.explanation_html')
      pre.hb-code
        code = home_example_code(t('.example.comment'))
      .hb-lesson__out
        span.hb-pill = t('.example.result')
        code True · False
